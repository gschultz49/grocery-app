{
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "crons": [
    {
      "path": "/api/cron/analyze-week",
      "schedule": "0 8 * * 0"
    },
    {
      "path": "/api/cron/generate-weekly",
      "schedule": "0 9 * * 0"
    }
  ]
}
